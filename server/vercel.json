{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"console.log('RentFleet API ready')\"",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:resource/:id/:action/:detail",
      "destination": "/api/index?__rf_path=:resource/:id/:action/:detail"
    },
    {
      "source": "/api/:resource/:id/:action",
      "destination": "/api/index?__rf_path=:resource/:id/:action"
    },
    {
      "source": "/api/:resource/:id",
      "destination": "/api/index?__rf_path=:resource/:id"
    },
    {
      "source": "/api/:resource",
      "destination": "/api/index?__rf_path=:resource"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
