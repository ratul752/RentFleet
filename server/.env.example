# Atlas connection string. Replace username, password and cluster hostname.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/RentFleet?retryWrites=true&w=majority
MONGODB_DB=RentFleet
PORT=5000
HOST=127.0.0.1
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Initial owner is created once; later changes do not reset the stored password.
OWNER_NAME=Fleet Owner
OWNER_EMAIL=
OWNER_PASSWORD=
# true enables Windows-only DNS override (8.8.8.8 / 1.1.1.1)
MONGO_DNS_FIX=true
